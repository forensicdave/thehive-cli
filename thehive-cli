def severityToStr ( severityNum ):
	if severityNum == 1:
		severityStr="low"
	elif severityNum == 2:
		severityStr="medium"
	elif severityNum == 3:
		severityStr="high"
	elif severityNum == 4:
		severityStr="critical"
	else:
		severityStr = "unknown"
	return severityStr
