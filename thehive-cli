			print(f"    2. The case {case_id} exists")
			print(f"    3. You have permissions to generate reports")
			return False

		if DEBUG:
			print(f"DEBUG: Report content type: {type(report_content)}", file=sys.stderr)
			if isinstance(report_content, dict):
				print(f"DEBUG: Report keys: {report_content.keys()}", file=sys.stderr)

		# Extract the actual report content
		# The response might be a dict with the report content in a specific field
		if isinstance(report_content, dict):
			# Try common field names
			for field in ['content', 'report', 'html', 'data', 'body']:
				if field in report_content:
					report_content = report_content[field]
					break

		# Convert to string if needed
		if not isinstance(report_content, str):
			report_content = str(report_content)

		# Output the report
		if output_file:
			with open(output_file, 'w', encoding='utf-8') as f:
				f.write(report_content)
			if json_output:
				return {"success": True, "action": "render_report", "case_id": case_id, "template": template_id, "output_file": output_file}
			print(f"✓ Report successfully rendered and saved to: {output_file}")
			print(f"  Size: {len(report_content)} characters")
		else:
			if json_output:
				return {"success": True, "action": "render_report", "case_id": case_id, "template": template_id, "content": report_content}
			print("\n" + "="*80)
			print("REPORT CONTENT")
			print("="*80 + "\n")
			print(report_content)
			print("\n" + "="*80 + "\n")

		return True

	except Exception as e:
		if json_output:
			return {"success": False, "action": "render_report", "case_id": case_id, "template": template_id, "error": str(e)}
		print(f"✗ Error rendering report: {e}")
		if DEBUG:
