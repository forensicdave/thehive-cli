def display_case_live_feed(api, case_id, case_number, json_output=False):
	"""Display live feed (recent activities) for a specific case"""
	if not json_output:
		print("\n###############")
		print(f"LIVE FEED - Case #{case_number}")
		print("###############\n")

	try:
		activities = []

		if DEBUG:
			print(f"DEBUG: Fetching live feed for case {case_id}", file=sys.stderr)

		# Get case timeline/history
		try:
			timeline_response = api.timeline.get(case_id)

			# Handle if response is a string (JSON) - parse it
			if isinstance(timeline_response, str):
				timeline = json.loads(timeline_response)
			else:
				timeline = timeline_response

			# Check if it's a dict with timeline data or directly a list
			if isinstance(timeline, dict):
				if 'timeline' in timeline:
					timeline = timeline['timeline']
				elif 'events' in timeline:
					timeline = timeline['events']
				else:
					timeline = [timeline]

			if timeline:
				for event in timeline:
					activities.append({
						'type': 'Timeline Event',
						'_createdAt': event.get('_createdAt', 0),
						'action': event.get('action', event.get('objectType', 'Activity')),
						'message': event.get('message', event.get('description', '')),
						'user': event.get('_createdBy', 'Unknown'),
						'details': event.get('details', '')
					})
				if DEBUG:
					print(f"DEBUG: Found {len(timeline)} timeline events", file=sys.stderr)
		except Exception as e:
			if DEBUG:
				print(f"DEBUG: Error fetching timeline: {e}", file=sys.stderr)

		# Get case comments using direct query
		try:
			query_payload = {
				"query": [
					{"_name": "getCase", "idOrName": case_id},
					{"_name": "comments"}
				]
			}
			comments = api.session.make_request("POST", "/api/v1/query", json=query_payload)

			if comments:
				for comment in comments:
					activities.append({
						'type': 'Comment',
						'_createdAt': comment.get('_createdAt', comment.get('createdAt', 0)),
						'action': 'Comment Added',
						'message': comment.get('message', ''),
						'user': comment.get('_createdBy', comment.get('createdBy', 'Unknown')),
						'details': ''
					})
				if DEBUG:
					print(f"DEBUG: Found {len(comments)} comments", file=sys.stderr)
		except Exception as e:
			if DEBUG:
				print(f"DEBUG: Error fetching comments: {e}", file=sys.stderr)

		# Get case tasks
		try:
			query_payload = {
				"query": [
					{"_name": "getCase", "idOrName": case_id},
					{"_name": "tasks"}
				]
			}
			tasks = api.session.make_request("POST", "/api/v1/query", json=query_payload)

			if tasks:
				for task in tasks:
					activities.append({
						'type': 'Task',
						'_createdAt': task.get('_createdAt', 0),
						'action': f"Task: {task.get('title', 'Untitled')}",
						'message': f"Status: {task.get('status', 'Unknown')}",
						'user': task.get('_createdBy', 'Unknown'),
						'details': task.get('description', '')
					})
				if DEBUG:
					print(f"DEBUG: Found {len(tasks)} tasks", file=sys.stderr)
		except Exception as e:
			if DEBUG:
				print(f"DEBUG: Error fetching tasks: {e}", file=sys.stderr)

		# Get case attachments
		try:
			attachments = api.case.find_attachments(case_id)
			if attachments:
				for attachment in attachments:
					activities.append({
						'type': 'Attachment',
						'_createdAt': attachment.get('_createdAt', 0),
						'action': 'Attachment Added',
						'message': f"File: {attachment.get('name', 'unknown')} ({attachment.get('size', 0)} bytes)",
						'user': attachment.get('_createdBy', 'Unknown'),
						'details': attachment.get('contentType', '')
					})
				if DEBUG:
					print(f"DEBUG: Found {len(attachments)} attachments", file=sys.stderr)
		except Exception as e:
			if DEBUG:
				print(f"DEBUG: Error fetching attachments: {e}", file=sys.stderr)

		# Sort all activities by timestamp (most recent first)
		activities.sort(key=lambda x: x.get('_createdAt', 0), reverse=True)

		if not activities:
			if json_output:
				return {"mode": "case_live_feed", "case_number": case_number, "count": 0, "activities": []}
			print("No recent activity found for this case.")
			return

		if json_output:
			clean = []
			for activity in activities:
				clean.append({
