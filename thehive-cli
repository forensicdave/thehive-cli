def display_case_comments(api, case_id, json_output=False):
	"""Display comments for a case"""
	if not json_output:
		print("\n###############")
		print("CASE COMMENTS")
		print("###############\n")

	try:
		if DEBUG:
			print(f"DEBUG: Looking for comments for case_id: {case_id}", file=sys.stderr)

		# Try direct API query to get comments for this case
		comments = []

		try:
			if DEBUG:
				print(f"DEBUG: Trying direct query API for case comments", file=sys.stderr)

			query_payload = {
				"query": [
					{"_name": "getCase", "idOrName": case_id},
					{"_name": "comments"}
				]
			}

			comments_response = api.session.make_request("POST", "/api/v1/query", json=query_payload)
			if comments_response:
				comments = comments_response
				if DEBUG:
					print(f"DEBUG: Direct comments query returned {len(comments)} comments", file=sys.stderr)
					if len(comments) > 0:
						print(f"DEBUG: First comment keys: {comments[0].keys()}", file=sys.stderr)
						print(f"DEBUG: First comment: {comments[0]}", file=sys.stderr)
		except Exception as e:
			if DEBUG:
				print(f"DEBUG: Direct comments query failed: {e}", file=sys.stderr)
				import traceback
				traceback.print_exc()

		# If direct query didn't work, try using api.comment with extraData filtering
		if not comments:
			if DEBUG:
				print(f"DEBUG: Direct query failed, trying api.comment.find()", file=sys.stderr)

			try:
				all_comments = api.comment.find(filters=None)
				if DEBUG:
					print(f"DEBUG: Retrieved {len(all_comments)} total comments", file=sys.stderr)
					if len(all_comments) > 0:
						print(f"DEBUG: First comment keys: {all_comments[0].keys()}", file=sys.stderr)
						print(f"DEBUG: First comment extraData: {all_comments[0].get('extraData')}", file=sys.stderr)

				# Filter comments - check extraData for case reference
				for comment in all_comments:
					extra = comment.get('extraData', {})
					# Check if extraData contains case reference
					if isinstance(extra, dict):
						if extra.get('case') == case_id or extra.get('caseId') == case_id:
							comments.append(comment)
						elif extra.get('case') == case_id.lstrip('~') or extra.get('caseId') == case_id.lstrip('~'):
							comments.append(comment)

				if DEBUG:
					print(f"DEBUG: Found {len(comments)} comments after extraData filtering", file=sys.stderr)
			except Exception as e:
				if DEBUG:
					print(f"DEBUG: Error with api.comment.find: {e}", file=sys.stderr)

		if not comments or len(comments) == 0:
			if json_output:
				return {"mode": "comments", "case_id": case_id, "count": 0, "comments": []}
			print("No comments found for this case.")
			if DEBUG:
				print(f"DEBUG: Final comment count is 0", file=sys.stderr)
			return

		# Now process and display comments
		if DEBUG:
			print(f"DEBUG: Processing {len(comments)} comments for display", file=sys.stderr)

		# Sort by date (oldest first for comments)
		sorted_comments = sorted(comments, key=lambda x: x.get('_createdAt', x.get('createdAt', 0)))

		if json_output:
			result = []
			for idx, comment in enumerate(sorted_comments, 1):
				timestamp_field = '_createdAt' if '_createdAt' in comment else 'createdAt'
				creator_field = '_createdBy' if '_createdBy' in comment else 'createdBy'
				c = {
					"index": idx,
					"created_at": format_timestamp(comment.get(timestamp_field)),
					"created_by": comment.get(creator_field, ''),
					"message": comment.get('message', ''),
					"is_edited": comment.get('isEdited', False)
				}
				if '_updatedAt' in comment and comment.get('_updatedAt') != comment.get(timestamp_field):
					c["updated_at"] = format_timestamp(comment['_updatedAt'])
				result.append(c)
			return {"mode": "comments", "case_id": case_id, "count": len(result), "comments": result}

		for idx, comment in enumerate(sorted_comments, 1):
			print(f"Comment #{idx}")
			print("-" * 50)

			# Created timestamp - check both _createdAt and createdAt
			timestamp_field = '_createdAt' if '_createdAt' in comment else 'createdAt'
			if timestamp_field in comment:
				timestamp = comment[timestamp_field] / 1000
				dt_object = datetime.fromtimestamp(int(timestamp))
				print(f"  Date       : {dt_object.strftime('%Y-%m-%d %H:%M:%S')}")

			# User who created the comment - check both _createdBy and createdBy
			creator_field = '_createdBy' if '_createdBy' in comment else 'createdBy'
			if creator_field in comment:
				print(f"  Created By : {comment[creator_field]}")

			# Comment message
			if 'message' in comment:
				# Handle multi-line messages
				message = comment['message']
				lines = message.split('\n')
				if len(lines) == 1:
					print(f"  Message    : {message}")
				else:
					print(f"  Message    :")
					for line in lines:
						print(f"               {line}")

			# Updated timestamp if different from created
			if '_updatedAt' in comment and timestamp_field in comment:
				if comment['_updatedAt'] != comment[timestamp_field]:
					timestamp = comment['_updatedAt'] / 1000
					dt_object = datetime.fromtimestamp(int(timestamp))
					print(f"  Updated    : {dt_object.strftime('%Y-%m-%d %H:%M:%S')}")

			# Show if edited
			if 'isEdited' in comment and comment['isEdited']:
				print(f"  Edited     : Yes")

			print()

	except Exception as e:
		print(f"Error retrieving comments: {e}")
		if DEBUG:
			import traceback
			print(traceback.format_exc())

def display_case_observables(api, case_id, case_number, json_output=False):
	"""Display all observables for a case with full field detail"""
	if not json_output:
		print("\n###############")
		print(f"OBSERVABLES - Case #{case_number}")
		print("###############\n")

	try:
		observables = []

		if DEBUG:
			print(f"DEBUG: Fetching observables for case_id='{case_id}' case_number={case_number}", file=sys.stderr)

		# Strategy 1: Query API (same pattern as comments/tasks — most reliable in TheHive5)
		try:
			query_payload = {
				"query": [
					{"_name": "getCase", "idOrName": case_id},
					{"_name": "observables"}
				]
			}
			if DEBUG:
				print(f"DEBUG: Trying query API with payload: {query_payload}", file=sys.stderr)
			obs_response = api.session.make_request("POST", "/api/v1/query", json=query_payload)
			if DEBUG:
				print(f"DEBUG: Query API response type: {type(obs_response)}, value: {obs_response}", file=sys.stderr)
			if obs_response:
				observables = obs_response
				if DEBUG:
					print(f"DEBUG: Got {len(observables)} observables from query API", file=sys.stderr)
					if observables:
						print(f"DEBUG: First observable keys: {list(observables[0].keys())}", file=sys.stderr)
		except Exception as e:
			if DEBUG:
				print(f"DEBUG: Query API strategy failed: {e}", file=sys.stderr)
				import traceback
				traceback.print_exc(file=sys.stderr)

		# Strategy 2: Direct REST endpoint
		if not observables:
			try:
				endpoint = f"/api/v1/case/{case_id}/observable"
				if DEBUG:
					print(f"DEBUG: Trying REST endpoint: {endpoint}", file=sys.stderr)
				obs_response = api.session.make_request("GET", endpoint)
				if DEBUG:
					print(f"DEBUG: REST endpoint response type: {type(obs_response)}, value: {obs_response}", file=sys.stderr)
				if obs_response:
					observables = obs_response
					if DEBUG:
						print(f"DEBUG: Got {len(observables)} observables from REST endpoint", file=sys.stderr)
			except Exception as e:
				if DEBUG:
					print(f"DEBUG: REST endpoint strategy failed: {e}", file=sys.stderr)

		# Strategy 3: case.get() — observables embedded in case object
		if not observables:
			try:
				if DEBUG:
					print(f"DEBUG: Trying case.get()", file=sys.stderr)
				case_details = api.case.get(case_id)
				if DEBUG:
					print(f"DEBUG: case.get() keys: {list(case_details.keys())}", file=sys.stderr)
				if "observables" in case_details and len(case_details["observables"]) > 0:
					observables = case_details["observables"]
					if DEBUG:
						print(f"DEBUG: Got {len(observables)} observables from case.get()", file=sys.stderr)
				else:
					if DEBUG:
						print(f"DEBUG: case.get() returned no 'observables' key or empty list", file=sys.stderr)
			except Exception as e:
				if DEBUG:
					print(f"DEBUG: case.get() strategy failed: {e}", file=sys.stderr)

		# Strategy 4: observable.find() with Parent filter
		if not observables:
			try:
				from thehive4py.query.filters import Parent
				if DEBUG:
					print(f"DEBUG: Trying observable.find() with Parent filter", file=sys.stderr)
				result = api.observable.find(filters=Parent("case", case_id))
				if DEBUG:
					print(f"DEBUG: observable.find() returned: {type(result)}, len={len(result) if result else 0}", file=sys.stderr)
				if result:
					observables = result
					if DEBUG:
						print(f"DEBUG: Got {len(observables)} observables from observable.find()", file=sys.stderr)
			except Exception as e:
				if DEBUG:
					print(f"DEBUG: observable.find() strategy failed: {e}", file=sys.stderr)

		if not observables:
			if json_output:
				return {"mode": "list_observables", "case_number": case_number, "case_id": case_id, "count": 0, "observables": []}
			print("No observables found for this case.")
			return

		if json_output:
			result = []
			for obs in observables:
				o = {
					"_id": obs.get("_id", ""),
					"dataType": obs.get("dataType", ""),
					"data": obs.get("data", ""),
					"ioc": obs.get("ioc", False),
					"sighted": obs.get("sighted", False),
					"tlp": obs.get("tlpLabel", obs.get("tlp", "")),
					"pap": obs.get("papLabel", obs.get("pap", "")),
					"tags": obs.get("tags", []),
					"message": obs.get("message", ""),
					"created_at": format_timestamp(obs.get("_createdAt")),
					"created_by": obs.get("_createdBy", ""),
				}
				if obs.get("sightedAt"):
					o["sighted_at"] = format_timestamp(obs["sightedAt"])
				if obs.get("ignoreSimilarity") is not None:
					o["ignore_similarity"] = obs["ignoreSimilarity"]
				if obs.get("attachment"):
					att = obs["attachment"]
					o["attachment"] = {
						"name": att.get("name", ""),
						"size": att.get("size", 0),
						"contentType": att.get("contentType", ""),
					}
				result.append(o)
			return {"mode": "list_observables", "case_number": case_number, "case_id": case_id, "count": len(result), "observables": result}

		# Text output
		print(f"Found {len(observables)} observable(s):\n")
		for idx, obs in enumerate(observables, 1):
			print(f"Observable #{idx}")
			print("-" * 50)
			print(f"  Type       : {obs.get('dataType', 'N/A')}")

			# File attachments have no 'data' field — show attachment metadata instead
			if obs.get("dataType") == "file" and obs.get("attachment"):
				att = obs["attachment"]
				print(f"  File       : {att.get('name', 'N/A')}")
				print(f"  Size       : {att.get('size', 0)} bytes")
				print(f"  MIME       : {att.get('contentType', 'N/A')}")
			elif obs.get("data"):
				print(f"  Data       : {obs['data']}")

			print(f"  IOC        : {'Yes' if obs.get('ioc') else 'No'}")
			print(f"  Sighted    : {'Yes' if obs.get('sighted') else 'No'}")

			tlp = obs.get("tlpLabel", obs.get("tlp", ""))
			if tlp != "" and tlp is not None:
				print(f"  TLP        : {tlp}")

			pap = obs.get("papLabel", obs.get("pap", ""))
			if pap != "" and pap is not None:
				print(f"  PAP        : {pap}")

			tags = obs.get("tags", [])
			if tags:
				print(f"  Tags       : {', '.join(tags)}")

			message = obs.get("message", "")
			if message:
				print(f"  Message    : {message}")

			if "_createdAt" in obs:
				print(f"  Created    : {format_timestamp(obs['_createdAt'])}")
			if "_createdBy" in obs:
				print(f"  Created By : {obs['_createdBy']}")

			print()

	except Exception as e:
		if json_output:
			return {"mode": "list_observables", "case_number": case_number, "case_id": case_id, "count": 0, "observables": [], "error": str(e)}
		print(f"Error retrieving observables: {e}")
		if DEBUG:
			import traceback
			traceback.print_exc()


