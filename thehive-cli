def get_case_event(api, case_id, event_id):
	"""Fetch a single custom timeline event (by id) as {_id,title,description,date,endDate}, or None."""
	try:
		events = _timeline_events(api, case_id)
	except Exception as e:
		if DEBUG:
			print(f"DEBUG: get_case_event timeline fetch failed: {e}", file=sys.stderr)
		return None
	for ev in events:
		if ev.get("entityId") == event_id and _is_custom_event(ev):
			details = ev.get("details") or {}
			return {
				"_id": event_id,
				"title": details.get("title", ev.get("title", "")),
				"description": details.get("description", ev.get("description", "")),
				"date": ev.get("date"),
				"endDate": ev.get("endDate"),
			}
	return None


def _parse_event_header(header_lines):
	"""Parse Title/Date/EndDate from editor header lines into a dict of strings."""
	out = {"title": "", "date_str": "", "end_str": ""}
	for ln in header_lines:
		s = ln.strip()
		if not s or s.startswith("#"):
			continue
		key, sep, val = ln.partition(":")
		if not sep:
			continue
		k = key.strip().lower()
		v = val.strip()
		if k == "title":
			out["title"] = v
		elif k == "date":
			out["date_str"] = v
		elif k == "enddate":
			out["end_str"] = v
	return out


def _event_buffer(title, date_ms, end_ms, description):
	"""Build the front-matter editor buffer for a timeline event."""
	return "\n".join([
		"# TheHive timeline event. Edit the fields below, then save and exit.",
		"# Lines in this header starting with '#' are ignored.",
		"# Date/EndDate: 'YYYY-MM-DD HH:MM[:SS]' (local) or epoch-ms. EndDate is optional.",
		"# The first line that is exactly '---' separates the header from the description.",
		"# To abort, save unchanged or remove the '---' separator.",
		f"Title: {title}",
		f"Date: {format_timestamp(date_ms) if date_ms else ''}",
		f"EndDate: {format_timestamp(end_ms) if end_ms else ''}",
		"---",
		description,
	]) + "\n"


def create_event_interactively():
	"""Open an empty timeline-event buffer in $EDITOR and return an InputCustomEvent dict.

	Returns None if aborted (empty title, missing separator, bad date, or editor failure).
	"""
	edited = _launch_editor(_event_buffer("", None, None, ""))
	if edited is None:
		return None

	header_lines, description = _split_frontmatter(edited)
	if header_lines is None:
		print("✗ Could not find the '---' separator in the edited file; aborting (event not created).")
		return None

	f = _parse_event_header(header_lines)
	title = f["title"].strip()
	if not title:
		print("✗ No title provided; aborting (event not created).")
		return None

	if f["date_str"] == "":
		date_ms = int(datetime.now().timestamp() * 1000)
	else:
		date_ms = parse_datetime_to_ms(f["date_str"])
		if date_ms is None:
			print(f"✗ Could not parse Date '{f['date_str']}'; aborting (event not created).")
			return None

	event = {"date": date_ms, "title": title}
	desc = description.rstrip("\n")
	if desc:
		event["description"] = desc
	if f["end_str"]:
		end_ms = parse_datetime_to_ms(f["end_str"])
		if end_ms is None:
			print(f"✗ Could not parse EndDate '{f['end_str']}'; aborting (event not created).")
			return None
		event["endDate"] = end_ms
	return event


def edit_event_interactively(event):
	"""Open a custom event in $EDITOR and return a dict of changed fields (InputUpdateCustomEvent).

	Returns {} if nothing changed, or None if aborted / unparseable / bad date.
	"""
	orig_title = event.get("title", "")
	orig_date = event.get("date")
	orig_end = event.get("endDate")
	orig_desc = event.get("description", "")

	buffer_text = _event_buffer(orig_title, orig_date, orig_end, orig_desc)
	edited = _launch_editor(buffer_text)
	if edited is None:
		return None
	if edited == buffer_text:
		return {}

	header_lines, new_desc = _split_frontmatter(edited)
	if header_lines is None:
		print("✗ Could not find the '---' separator in the edited file; aborting (no changes applied).")
		return None

	f = _parse_event_header(header_lines)
	changed = {}

	new_title = f["title"].strip() or orig_title
	if new_title != orig_title:
		changed["title"] = new_title

	if f["date_str"] != "":
		new_date = parse_datetime_to_ms(f["date_str"])
		if new_date is None:
			print(f"✗ Could not parse Date '{f['date_str']}'; aborting (no changes applied).")
			return None
		if new_date != orig_date:
			changed["date"] = new_date

	if f["end_str"] != "":
		new_end = parse_datetime_to_ms(f["end_str"])
		if new_end is None:
			print(f"✗ Could not parse EndDate '{f['end_str']}'; aborting (no changes applied).")
			return None
		if new_end != orig_end:
			changed["endDate"] = new_end

	if new_desc.rstrip("\n") != (orig_desc or "").rstrip("\n"):
		changed["description"] = new_desc.rstrip("\n")

	return changed


