			sys.exit(1)
		if not update_fields:
			if JSON_OUTPUT:
				print(json.dumps({"success": True, "action": "update_event", "event_id": args.update_event, "changed": False, "updated_fields": []}, indent=2))
			else:
				print("No changes detected; event not updated.")
			exit(0)

		# Lost-update guard: bail if a field we changed was edited elsewhere while we were in $EDITOR
		conflicts = check_lost_update(current_event, update_fields.keys(), lambda: get_case_event(api, case_id, args.update_event))
		if conflicts:
			saved = report_lost_update(conflicts, update_fields, json_output=JSON_OUTPUT)
			if JSON_OUTPUT:
				print(json.dumps({"success": False, "action": "update_event", "event_id": args.update_event, "conflict": list(conflicts.keys()), "saved_edit": saved}, indent=2))
			sys.exit(1)
	else:
		update_fields = {}
		if args.event_title != '':
			update_fields["title"] = args.event_title
		if args.event_date != '':
			date_ms = parse_datetime_to_ms(args.event_date)
			if date_ms is None:
				print(f"ERROR: could not parse --event-date '{args.event_date}' (use 'YYYY-MM-DD HH:MM' or epoch-ms)")
				sys.exit(1)
			update_fields["date"] = date_ms
		if args.event_end != '':
			end_ms = parse_datetime_to_ms(args.event_end)
			if end_ms is None:
				print(f"ERROR: could not parse --event-end '{args.event_end}' (use 'YYYY-MM-DD HH:MM' or epoch-ms)")
				sys.exit(1)
			update_fields["endDate"] = end_ms
		event_desc = args.event_description
		if event_desc == '-':
			try:
				event_desc = sys.stdin.read().rstrip("\n")
			except Exception as e:
				print(f"ERROR: Failed to read event description from stdin: {e}")
				sys.exit(1)
		if event_desc != '':
			update_fields["description"] = event_desc
		if not update_fields:
			print("ERROR: --update-event requires at least one --event-* field (or use --interactive)")
			sys.exit(1)

	result = update_case_event(api, args.update_event, update_fields, json_output=JSON_OUTPUT)
	if JSON_OUTPUT:
		success = result.get("success", False) if isinstance(result, dict) else bool(result)
		print(json.dumps(result, indent=2))
		exit(0 if success else 1)
	exit(0 if result else 1)

