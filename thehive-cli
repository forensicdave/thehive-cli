		"# The first line that is exactly '---' separates the header (Title)",
		"# from the case description (everything below it is the markdown body).",
		"# Leave the title blank (or remove the '---' separator) to abort.",
		"Title: ",
		"---",
		"",
	]) + "\n"

	edited = _launch_editor(buffer_text)
	if edited is None:
		return None

	header_lines, description = _split_frontmatter(edited)
	if header_lines is None:
