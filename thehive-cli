def display_live_feed(api, limit=20, json_output=False):
	"""Display recent activity (alerts and case updates) like the Live feed"""
	if not json_output:
		print("\n###############")
		print("LIVE FEED")
		print("###############\n")

	try:
		activities = []

		# Get recent alerts
		if DEBUG:
			print(f"DEBUG: Fetching recent alerts", file=sys.stderr)

		try:
			alerts = api.alert.find(filters=None, sortby=[{"_field": "_createdAt", "_order": "desc"}])
			if alerts:
				for alert in alerts[:limit]:
					activities.append({
						'type': 'Alert',
						'_createdAt': alert.get('_createdAt', 0),
						'title': alert.get('title', 'Untitled Alert'),
						'severity': alert.get('severity', 0),
						'status': alert.get('status', 'Unknown'),
						'_id': alert.get('_id', ''),
						'source': alert.get('source', 'Unknown'),
						'_createdBy': alert.get('_createdBy', 'Unknown')
					})
				if DEBUG:
					print(f"DEBUG: Found {len(alerts[:limit])} recent alerts", file=sys.stderr)
		except Exception as e:
			if DEBUG:
				print(f"DEBUG: Error fetching alerts: {e}", file=sys.stderr)

		# Get recent cases (updated or created)
		if DEBUG:
			print(f"DEBUG: Fetching recent cases", file=sys.stderr)

		try:
			from thehive4py.query.sort import Desc
			recent_cases = api.case.find(filters=None, sortby=Desc("_updatedAt"))
			if recent_cases:
				for case in recent_cases[:limit]:
					activities.append({
						'type': 'Case',
						'_createdAt': case.get('_updatedAt', case.get('_createdAt', 0)),
						'title': case.get('title', 'Untitled Case'),
						'severity': case.get('severity', 0),
						'status': case.get('stage', case.get('status', 'Unknown')),
						'_id': case.get('_id', ''),
						'number': case.get('number', ''),
						'_createdBy': case.get('_updatedBy', case.get('_createdBy', 'Unknown'))
					})
				if DEBUG:
					print(f"DEBUG: Found {len(recent_cases[:limit])} recent cases", file=sys.stderr)
		except Exception as e:
			if DEBUG:
				print(f"DEBUG: Error fetching cases: {e}", file=sys.stderr)

		# Sort all activities by timestamp (most recent first)
		activities.sort(key=lambda x: x.get('_createdAt', 0), reverse=True)

		# Limit to requested number
		activities = activities[:limit]

		if not activities:
			if json_output:
				return {"mode": "live_feed", "limit": limit, "count": 0, "activities": []}
			print("No recent activity found.")
			return

		if json_output:
			clean = []
			for activity in activities:
				_id = activity.get('_id', '')
				entry = {
					"type": activity['type'],
					"title": activity['title'],
					"severity": severityToStr(activity.get('severity', 0)),
					"status": activity.get('status', ''),
					"_id": _id,
					"created_by": activity.get('_createdBy', ''),
					"created_at": format_timestamp(activity.get('_createdAt')),
					"url": (THEHIVE_URL + f"/alerts/{_id}/details") if activity['type'] == 'Alert' else (THEHIVE_URL + f"/cases/{_id}/details")
				}
				if activity['type'] == 'Alert':
					entry["source"] = activity.get('source', '')
				else:
					entry["number"] = activity.get('number', '')
				clean.append(entry)
			return {"mode": "live_feed", "limit": limit, "count": len(clean), "activities": clean}

		print(f"Showing {len(activities)} most recent activities:\n")

		for idx, activity in enumerate(activities, 1):
			print(f"{idx}. [{activity['type']}] ", end="")

			# Format timestamp
			if '_createdAt' in activity and activity['_createdAt']:
				timestamp = activity['_createdAt'] / 1000
				dt_object = datetime.fromtimestamp(int(timestamp))
				print(f"{dt_object.strftime('%Y-%m-%d %H:%M:%S')} - ", end="")

			# Title and severity
			severity_str = severityToStr(activity.get('severity', 0))
			print(f"{activity['title']} [{severity_str}]")

			# Additional details
			if activity['type'] == 'Alert':
				print(f"   Source: {activity['source']}, Status: {activity['status']}, By: {activity['_createdBy']}")
			else:
				print(f"   Case #{activity['number']}, Stage: {activity['status']}, By: {activity['_createdBy']}")

			# URL
			if activity['_id']:
				if activity['type'] == 'Alert':
					url = THEHIVE_URL + f"/alerts/{activity['_id']}/details"
				else:
					url = THEHIVE_URL + f"/cases/{activity['_id']}/details"
				print(f"   URL: {url}")

			print()

	except Exception as e:
		print(f"Error retrieving live feed: {e}")
		if DEBUG:
			import traceback
			traceback.print_exc()

def display_case_history(api, case_id, json_output=False):
	"""Display the activity history/timeline for a case"""
	if not json_output:
		print("\n###############")
		print("CASE HISTORY")
		print("###############\n")

	try:
		# Use TheHive5 API timeline.get() method
		timeline_response = api.timeline.get(case_id)

		# Handle if response is a string (JSON) - parse it
		if isinstance(timeline_response, str):
			timeline = json.loads(timeline_response)
		else:
			timeline = timeline_response

		# Check if it's a dict with timeline data or directly a list
		if isinstance(timeline, dict):
			if 'timeline' in timeline:
				timeline = timeline['timeline']
			elif 'events' in timeline:
				timeline = timeline['events']
			else:
				# Might be a single timeline object, wrap in list
				timeline = [timeline]

		if not timeline or len(timeline) == 0:
			if json_output:
				return {"mode": "history", "case_id": case_id, "count": 0, "entries": []}
			print("No history/timeline entries found for this case.")
			return

		# Sort by date (most recent first)
		sorted_timeline = sorted(timeline, key=lambda x: x.get('_createdAt', 0), reverse=True)

		if json_output:
			result = []
			for entry in sorted_timeline:
				result.append({
					"created_at": format_timestamp(entry.get('_createdAt')),
					"created_by": entry.get('_createdBy', ''),
					"object_type": entry.get('objectType', ''),
					"action": entry.get('action', ''),
					"message": entry.get('message', ''),
					"description": entry.get('description', ''),
					"status": entry.get('status', ''),
					"title": entry.get('title', '')
				})
			return {"mode": "history", "case_id": case_id, "count": len(result), "entries": result}

		for idx, entry in enumerate(sorted_timeline, 1):
			print(f"Activity #{idx}")
			print("-" * 50)

			# Priority fields to show first
			priority_fields = ['_createdAt', '_createdBy', 'objectType', 'action',
			                  'message', 'description', 'status', 'title']

			# Display priority fields first
			for field in priority_fields:
				if field in entry:
					label = field.replace('_', '').title()
					value = format_field_value(field, entry[field])
					print(f"  {label:15s}: {value}")

			# Display remaining fields (excluding internal/system fields and already shown)
			for key, value in entry.items():
				# Skip already displayed fields and internal fields we don't need
				if key in priority_fields or key.startswith('_') and key not in ['_id']:
					continue

				label = key.replace('_', ' ').title()
				formatted_value = format_field_value(key, value)
				print(f"  {label:15s}: {formatted_value}")

			print()

	except Exception as e:
		print(f"Error retrieving case history: {e}")
		print("Note: History feature requires appropriate API permissions.")
		if DEBUG:
			import traceback
			print(traceback.format_exc())


