def write_to_clipboard(output):
	process = subprocess.Popen(
		'/usr/bin/pbcopy', env={'LANG': 'en_US.UTF-8'}, stdin=subprocess.PIPE)
	process.communicate(output.encode('utf-8'))

def store_credentials():
	"""Store TheHive API credentials in keychain"""
	print("Store TheHive Credentials in Keychain")
	print("=" * 50)

	url = input("Enter TheHive URL (e.g., http://192.168.2.49:9000): ").strip()
	if not url:
		print("URL cannot be empty")
		return False

	api_key = getpass.getpass("Enter TheHive API Key: ").strip()
	if not api_key:
		print("API key cannot be empty")
		return False

	try:
		keyring.set_password("thehive", "url", url)
		keyring.set_password("thehive", "api_key", api_key)
		print("\nCredentials stored successfully in keychain!")
		return True
	except Exception as e:
		print(f"Error storing credentials: {e}")
		return False

def show_credentials():
	"""Display currently stored TheHive credentials from keychain"""
	url = keyring.get_password("thehive", "url")
	api_key = keyring.get_password("thehive", "api_key")

	print("Stored TheHive Credentials")
	print("=" * 50)
	if url:
		print(f"URL:     {url}")
	else:
		print("URL:     (not set)")

	if api_key:
		masked = api_key[:4] + "*" * (len(api_key) - 8) + api_key[-4:] if len(api_key) > 8 else "****"
		print(f"API Key: {masked}")
	else:
		print("API Key: (not set)")

	if not url or not api_key:
		print("\nRun with --store-key to set missing credentials.")

def get_credentials(url_override='', api_key_override=''):
	"""Get TheHive credentials from keychain or overrides"""

	# Use command-line overrides if provided
	if url_override:
		url = url_override
	else:
		url = keyring.get_password("thehive", "url")
		if not url:
			print("ERROR: No URL found in keychain and none provided via --url")
			print("Please run with --store-key to store credentials, or provide --url on command line")
			sys.exit(1)

	if api_key_override:
		api_key = api_key_override
	else:
		api_key = keyring.get_password("thehive", "api_key")
		if not api_key:
			print("ERROR: No API key found in keychain and none provided via --api-key")
			print("Please run with --store-key to store credentials, or provide --api-key on command line")
			sys.exit(1)

	return url, api_key

def format_timestamp(timestamp_ms):
	"""Convert millisecond timestamp to readable datetime string"""
	if timestamp_ms:
		try:
			timestamp_sec = int(timestamp_ms) / 1000
			dt_object = datetime.fromtimestamp(timestamp_sec)
			return dt_object.strftime('%Y-%m-%d %H:%M:%S')
		except:
			return str(timestamp_ms)
	return "N/A"

def format_field_value(key, value):
	"""Format field values for display, handling special cases"""
	# Time field names that should be converted
	time_fields = ['_createdAt', '_updatedAt', 'createdAt', 'updatedAt',
	               'startDate', 'endDate', 'date', 'timestamp', 'occurDate']

	if key in time_fields and isinstance(value, (int, float)):
		return format_timestamp(value)
	elif isinstance(value, dict):
		# Nested dictionary - format as indented key-value pairs
		result = ""
		for k, v in value.items():
			if not k.startswith('_'):  # Skip internal fields
				formatted_v = format_field_value(k, v)
				result += f"\n      {k}: {formatted_v}"
		return result if result else str(value)
	elif isinstance(value, list):
		# List - format as comma-separated or numbered items
		if len(value) == 0:
			return "[]"
		elif len(value) <= 3:
			return ", ".join(str(v) for v in value)
		else:
			return f"[{len(value)} items]"
	else:
		return str(value)

def _sort_files(paths, sort_mode="mtime", reverse=False):
	"""Sort file paths by 'name' (A->Z), 'mtime' (newest first) or 'size' (largest first).
	`reverse` flips whichever order the mode uses by default."""
	def _stat(p, attr):
		try:
			return getattr(os.stat(p), attr)
		except OSError:
			return 0
	if sort_mode == "mtime":
		return sorted(paths, key=lambda p: _stat(p, "st_mtime"), reverse=not reverse)
	if sort_mode == "size":
		return sorted(paths, key=lambda p: _stat(p, "st_size"), reverse=not reverse)
	# name: default order for this mode is ascending, case-insensitive
	return sorted(paths, key=lambda p: os.path.basename(p).lower(), reverse=reverse)


def _collect_files(start_dir):
	"""Recursively list non-hidden files under start_dir (skipping hidden directories)."""
	out = []
	for root, dirs, files in os.walk(start_dir):
		dirs[:] = [d for d in dirs if not d.startswith(".")]
		for f in files:
			if not f.startswith("."):
				out.append(os.path.join(root, f))
	return out


def pick_file_interactively(start_dir=".", sort_mode="mtime", reverse=False):
	"""Interactively choose a file under start_dir: fzf if available, otherwise a
	TAB-completing prompt (press Enter to browse a numbered menu). The candidate list is
	sorted by sort_mode. Returns a path, or None if cancelled."""
	if shutil.which("fzf"):
		return _pick_with_fzf(start_dir, sort_mode, reverse)
	return _prompt_for_path(start_dir, sort_mode, reverse)


def _pick_with_fzf(start_dir=".", sort_mode="mtime", reverse=False):
	"""Feed fzf the sorted files under start_dir; return the selection or None."""
	files = _sort_files(_collect_files(start_dir), sort_mode, reverse)
	if not files:
		print(f"No files found under {start_dir}.")
		return None
	try:
		# --reverse puts the first (e.g. newest) item at the top; typing re-ranks by match
		proc = subprocess.run(
			["fzf", "--prompt", "attachment> ", "--reverse"],
			input="\n".join(files), stdout=subprocess.PIPE, text=True)
	except Exception as e:
		if DEBUG:
			print(f"DEBUG: fzf invocation failed: {e}", file=sys.stderr)
		return _prompt_for_path(start_dir, sort_mode, reverse)
	if proc.returncode != 0:
		return None  # cancelled (Esc / Ctrl-C) or no match
	sel = proc.stdout.strip()
	return sel or None


def _prompt_for_path(start_dir=".", sort_mode="mtime", reverse=False):
	"""Prompt for a file path with readline TAB-completion; empty input opens a numbered
	browser. When start_dir is given, the prompt is pre-filled with it."""
	prefill = os.path.join(start_dir, "") if start_dir not in ("", ".") else ""
	try:
		import readline
		import glob

		def _completer(text, state):
			expanded = os.path.expanduser(text)
			matches = [m + ("/" if os.path.isdir(m) else "") for m in glob.glob(expanded + "*")]
			return matches[state] if state < len(matches) else None

		readline.set_completer_delims(" \t\n")
		readline.set_completer(_completer)
		# macOS ships libedit, which binds completion differently from GNU readline
		if "libedit" in (readline.__doc__ or ""):
			readline.parse_and_bind("bind ^I rl_complete")
		else:
			readline.parse_and_bind("tab: complete")
		if prefill:
			readline.set_startup_hook(lambda: readline.insert_text(prefill))
	except Exception:
		pass

	try:
		path = input("File path (TAB to complete, Enter to browse): ").strip()
	except (EOFError, KeyboardInterrupt):
		print()
		return None
	finally:
		try:
			import readline
			readline.set_completer(None)
			readline.set_startup_hook()
		except Exception:
			pass

	if not path:
		return _browse_menu(start_dir, sort_mode, reverse)
	return os.path.expanduser(path)


def _browse_menu(start, sort_mode="mtime", reverse=False):
	"""Numbered directory browser: directories alphabetical, files by sort_mode.
	Returns a chosen file path or None."""
	cur = os.path.abspath(start)
	while True:
		try:
			names = os.listdir(cur)
		except OSError as e:
			print(f"  cannot read {cur}: {e}")
			return None
		dirs = sorted([n for n in names if os.path.isdir(os.path.join(cur, n))], key=str.lower)
		file_paths = _sort_files(
			[os.path.join(cur, n) for n in names if os.path.isfile(os.path.join(cur, n))],
			sort_mode, reverse)
		files = [os.path.basename(p) for p in file_paths]
		items = [".. (up)"] + [d + "/" for d in dirs] + files
		print(f"\n  {cur}   (files by {sort_mode})")
		for i, it in enumerate(items):
			print(f"   {i:>3}  {it}")
		try:
			sel = input("  number to open/select ('q' to cancel): ").strip()
		except (EOFError, KeyboardInterrupt):
			print()
			return None
		if sel.lower() == "q" or sel == "":
			return None
		if not sel.isdigit() or int(sel) >= len(items):
			print("  invalid selection")
			continue
		idx = int(sel)
		if idx == 0:
			cur = os.path.dirname(cur)
		elif items[idx].endswith("/"):
			cur = os.path.join(cur, items[idx][:-1])
		else:
			return os.path.join(cur, items[idx])


def prompt_upload_name(default):
	"""Prompt for the name to store the attachment under, pre-filled with `default` (editable)."""
	try:
		import readline
		readline.set_startup_hook(lambda: readline.insert_text(default))
	except Exception:
		readline = None
	try:
		name = input("Upload as: " if readline else f"Upload as [{default}]: ").strip()
	except (EOFError, KeyboardInterrupt):
		name = ""
	finally:
		try:
			if readline:
				readline.set_startup_hook()
		except Exception:
			pass
	return name or default


def add_attachment_to_case(api, case_id, file_path, timestamp=False, upload_name=None, json_output=False):
	"""Add an attachment to a case, optionally under a different name (upload_name)."""
	if not json_output:
		print("\n###############")
		print("ADD ATTACHMENT")
		print("###############\n")

	tmp_dir = None
	try:
		# Validate file exists
		if not os.path.exists(file_path):
			print(f"✗ Error: File not found: {file_path}")
			return False

		if not os.path.isfile(file_path):
			print(f"✗ Error: Path is not a file: {file_path}")
			return False

		# Get file size for display
		file_size = os.path.getsize(file_path)

		# Name TheHive will store: explicit upload_name, else the original basename;
		# an optional timestamp prefix composes on top of either.
		file_name = upload_name if upload_name else os.path.basename(file_path)
		if timestamp:
			ts = datetime.now(timezone.utc).strftime('%Y%m%d_%H%M%S_')
			file_name = ts + file_name

		# TheHive names the attachment from the uploaded path's basename, so when the
		# desired name differs from the original we upload a symlink carrying the new name.
		upload_path = file_path
		if file_name != os.path.basename(file_path):
			tmp_dir = tempfile.mkdtemp()
			upload_path = os.path.join(tmp_dir, file_name)
			os.symlink(os.path.abspath(file_path), upload_path)
			if DEBUG:
				print(f"DEBUG: Uploading under name: {file_name}", file=sys.stderr)

		if DEBUG:
			print(f"DEBUG: Adding attachment to case_id: {case_id}", file=sys.stderr)
			print(f"DEBUG: File path: {file_path}", file=sys.stderr)
			print(f"DEBUG: File name: {file_name}", file=sys.stderr)
			print(f"DEBUG: File size: {file_size} bytes", file=sys.stderr)

		if not json_output:
			print(f"Uploading: {file_name} ({file_size} bytes)")

		# Add the attachment using TheHive API
		# The API expects a list of file paths
		result = api.case.add_attachment(case_id, attachment_paths=[upload_path])

		if DEBUG:
			print(f"DEBUG: Attachment upload result: {result}", file=sys.stderr)

		if json_output:
			return {"success": True, "action": "add_attachment", "case_id": case_id, "file": file_name, "size": file_size}

		print(f"✓ Attachment successfully added to case {case_id}")
		print(f"  File: {file_name}")

		# Show attachment details if available
		if result and len(result) > 0:
			attachment = result[0]
			if hasattr(attachment, '_id'):
				print(f"  Attachment ID: {attachment._id}")
			if hasattr(attachment, 'name'):
				print(f"  Name: {attachment.name}")
			if hasattr(attachment, 'size'):
				print(f"  Size: {attachment.size} bytes")

		return True

	except Exception as e:
		if json_output:
			return {"success": False, "action": "add_attachment", "case_id": case_id, "error": str(e)}
		print(f"✗ Error adding attachment: {e}")
		if DEBUG:
			import traceback
			traceback.print_exc()
		return False

	finally:
		if tmp_dir:
			shutil.rmtree(tmp_dir, ignore_errors=True)

