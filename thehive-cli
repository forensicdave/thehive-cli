def add_observables_interactively():
	"""Open a line-based IOC table in $EDITOR and return a list of InputObservable dicts.

	Returns None on editor failure; [] if the buffer contained no observable lines.
	Line format:  <type>  <data>  [ioc] [sighted] [tags=a,b,c]
	"""
	buffer_text = "\n".join([
		"# Add observables - one per line:  <type>  <data>  [ioc] [sighted] [tags=a,b,c]",
		"# Lines starting with '#' are ignored. Save & exit to create; empty file aborts.",
		"#",
		"# examples:",
		"#   ip       45.83.12.9        ioc tags=c2,emotet",
		"#   domain   evil.example.com  ioc sighted",
		"#   hash     d41d8cd98f00b204e9800998ecf8427e",
		"",
	]) + "\n"

	edited = _launch_editor(buffer_text)
	if edited is None:
		return None

	observables = []
	for raw in edited.split("\n"):
		line = raw.strip()
		if not line or line.startswith("#"):
			continue
		tokens = line.split()
		if len(tokens) < 2:
			print(f"⚠ Skipping malformed line (need '<type> <data>'): {line!r}")
			continue
		obs = {"dataType": tokens[0], "data": tokens[1]}
		tags = []
		for tok in tokens[2:]:
			low = tok.lower()
			if low == "ioc":
				obs["ioc"] = True
			elif low == "sighted":
				obs["sighted"] = True
			elif tok.startswith("tags="):
				tags = [t.strip() for t in tok[len("tags="):].split(",") if t.strip()]
			else:
				print(f"⚠ Ignoring unknown token '{tok}' on line: {line!r}")
		if tags:
			obs["tags"] = tags
		observables.append(obs)

	return observables


def add_observables_to_case(api, case_id, observables, json_output=False):
	"""Create one or more observables in a case.

	`observables` is a list of InputObservable dicts; a dict may carry a special
	"_path" key for a file observable (popped and passed as observable_path).
	"""
	if not json_output:
		print("\n###############")
		print("ADD OBSERVABLE(S)")
		print("###############\n")

	created = []
	errors = []
	for obs in observables:
		path = obs.pop("_path", None)
		try:
			if DEBUG:
				print(f"DEBUG: Creating observable: {obs} path={path}", file=sys.stderr)
			res = api.case.create_observable(case_id, obs, observable_path=path)
			if res:
				created.extend(res)
		except Exception as e:
			errors.append({"dataType": obs.get("dataType"), "data": obs.get("data"), "error": str(e)})
			if DEBUG:
				import traceback
				traceback.print_exc()

	if json_output:
		out = {
			"success": len(errors) == 0,
			"action": "add_observable",
			"case_id": case_id,
			"created_count": len(created),
			"created": [{"_id": o.get("_id", ""), "dataType": o.get("dataType", ""), "data": o.get("data", "")} for o in created],
		}
		if errors:
			out["errors"] = errors
		return out

	print(f"✓ Created {len(created)} observable(s) in case {case_id}")
	for o in created:
		val = o.get("data")
		if not val and isinstance(o.get("attachment"), dict):
			val = o["attachment"].get("name", "")
		print(f"  [{o.get('dataType', '?')}] {val}")
	if errors:
		print(f"\n✗ {len(errors)} failed:")
		for e in errors:
			print(f"  [{e['dataType']}] {e['data']}: {e['error']}")
	return len(errors) == 0


def parse_datetime_to_ms(s):
	"""Parse 'YYYY-MM-DD HH:MM[:SS]' (local time), 'YYYY-MM-DD', or epoch-ms into epoch-ms.

	Returns None if the value cannot be parsed.
	"""
	s = s.strip()
	if not s:
		return None
	if s.isdigit():
		return int(s)
	for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d"):
		try:
			return int(datetime.strptime(s, fmt).timestamp() * 1000)
		except ValueError:
			continue
	return None


def _is_custom_event(ev):
	"""Heuristic: does this timeline event represent a user-authored custom event?"""
	entity = str(ev.get("entity", "")).lower()
	kind = str(ev.get("kind", "")).lower()
	return "custom" in entity or "custom" in kind


def _timeline_events(api, case_id):
