def render_case_report(api, case_id, template_id, output_file=None, json_output=False):
	"""Render a case report using a template"""
	if not json_output:
		print("\n##################")
		print("RENDER CASE REPORT")
		print("##################\n")

	try:
		if DEBUG:
			print(f"DEBUG: Rendering report for case_id: {case_id}", file=sys.stderr)
			print(f"DEBUG: Template ID: {template_id}", file=sys.stderr)
			print(f"DEBUG: Output file: {output_file}", file=sys.stderr)

		if not json_output:
			print(f"Rendering report for case {case_id} using template '{template_id}'...")

		# Try different API endpoints that might work for report rendering
		# TheHive5 API endpoint for rendering case reports
		# Based on TheHive patterns, try these endpoints:
		endpoints_to_try = [
			f"/api/v1/case/{case_id}/report/render/{template_id}",
			f"/api/v1/case/{case_id}/report/{template_id}",
			f"/api/v1/case/{case_id}/render-report/{template_id}",
		]

		report_content = None
		successful_endpoint = None

		for endpoint in endpoints_to_try:
			try:
				if DEBUG:
					print(f"DEBUG: Trying endpoint: {endpoint}", file=sys.stderr)

				response = api.session.make_request("GET", endpoint)

				if response:
					report_content = response
					successful_endpoint = endpoint
					if DEBUG:
						print(f"DEBUG: Success with endpoint: {endpoint}", file=sys.stderr)
					break
			except Exception as e:
				if DEBUG:
					print(f"DEBUG: Endpoint {endpoint} failed: {e}", file=sys.stderr)
				continue

		if report_content is None:
			if json_output:
				return {"success": False, "action": "render_report", "case_id": case_id, "template": template_id, "error": "Could not render report"}
			print(f"✗ Error: Could not render report. Tried multiple API endpoints.")
