def _launch_editor(buffer_text):
	"""Write buffer_text to a temp file, open it in $EDITOR (then $VISUAL, then vi)
	and return the edited text.

	Returns None if the editor could not be launched or exited with a non-zero status.
	"""
	editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "vi"
	tmp_path = None
	try:
		fd, tmp_path = tempfile.mkstemp(suffix=".md", prefix="hive_edit_")
		with os.fdopen(fd, "w", encoding="utf-8") as f:
			f.write(buffer_text)

		try:
			cmd = shlex.split(editor) + [tmp_path]
			if DEBUG:
				print(f"DEBUG: Launching editor: {cmd}", file=sys.stderr)
			rc = subprocess.call(cmd)
		except FileNotFoundError:
			print(f"✗ Error: editor '{editor}' not found. Set $EDITOR to a valid editor.")
			return None
		if rc != 0:
			print(f"✗ Editor exited with status {rc}; aborting.")
			return None

		with open(tmp_path, encoding="utf-8") as f:
			return f.read()
	finally:
		if tmp_path:
			try:
				os.unlink(tmp_path)
			except OSError:
				pass


def _split_frontmatter(text):
	"""Split editor text into (header_lines, body) on the first line that is exactly '---'.

	Returns (None, None) if no separator line is found.
	"""
	lines = text.split("\n")
	for i, ln in enumerate(lines):
		if ln.strip() == "---":
			return lines[:i], "\n".join(lines[i + 1:])
	return None, None


def compose_comment_interactively(initial=""):
	"""Compose a comment in $EDITOR (markdown). The whole buffer is the comment - no
	header/separator, so markdown headings ('#') are preserved. Returns the text, or
	None if the buffer was left empty or the edit was aborted."""
	edited = _launch_editor(initial or "")
	if edited is None:
		return None
	text = edited.strip()
	return text or None


def check_lost_update(original, fields, refetch):
	"""Lost-update guard for the read-modify-write interactive editors.

	TheHive has no optimistic-concurrency control on field updates, so an interactive edit
	(fetch -> sit in $EDITOR -> PATCH) can silently overwrite a change someone else made in
	the meantime. Just before applying, re-fetch the entity (via refetch()) and check whether
	any field we're about to change was modified since `original` was loaded.

	Returns a dict {field: current_server_value} of conflicts, or {} if none / undetectable.
	"""
	try:
		current = refetch()
	except Exception as e:
		if DEBUG:
			print(f"DEBUG: lost-update re-fetch failed ({e}); skipping the check", file=sys.stderr)
		return {}
	if not current:
		return {}

	def _norm(v):
		return v.rstrip("\n") if isinstance(v, str) else v

	conflicts = {}
	for f in fields:
		if _norm(original.get(f)) != _norm(current.get(f)):
			conflicts[f] = current.get(f)
	return conflicts


def report_lost_update(conflicts, update_fields, json_output=False):
	"""Preserve the user's pending edit to a temp file and report a lost-update conflict.

	Returns the save path (or None). The caller should abort after calling this.
	"""
	saved_path = None
	try:
		fd, saved_path = tempfile.mkstemp(suffix=".txt", prefix="thehive-edit-")
		with os.fdopen(fd, "w", encoding="utf-8") as fh:
			for f, v in update_fields.items():
				fh.write(f"# {f}\n{v}\n\n")
	except OSError:
		saved_path = None

	if not json_output:
		print("✗ Not applied: the following field(s) changed in TheHive while you were editing:")
		for f in conflicts:
			print(f"    - {f}")
		print("  Aborting to avoid overwriting someone else's change.")
		if saved_path:
			print(f"  Your edit was saved to: {saved_path}")
		print("  Re-run with --interactive to reconcile against the current version.")
	return saved_path


def edit_page_interactively(page):
	"""Open the page's fields in $EDITOR and return a dict of changed fields
	suitable for InputUpdateCasePage.

	Returns {} if nothing changed, or None if the edit was aborted / unparseable.
	"""
	orig_title = page.get("title", "")
	orig_category = page.get("category", "")
	orig_order = page.get("order", "")
	orig_content = page.get("content", "")

	buffer_text = "\n".join([
		"# TheHive page editor. Edit the fields below, then save and exit.",
		"# Lines in this header starting with '#' are ignored.",
		"# The first line that is exactly '---' separates the header from the",
		"# page content (everything below it is the markdown body).",
		"# To abort, save the file unchanged or remove the '---' separator.",
		f"Title: {orig_title}",
		f"Category: {orig_category}",
		f"Order: {orig_order}",
		"---",
		orig_content,
	]) + "\n"

	edited = _launch_editor(buffer_text)
	if edited is None:
		return None
	# Unchanged buffer => nothing to do
	if edited == buffer_text:
		return {}

	header_lines, new_content = _split_frontmatter(edited)
	if header_lines is None:
		print("✗ Could not find the '---' separator in the edited file; aborting (no changes applied).")
		return None

	new_title = orig_title
	new_category = orig_category
	new_order_str = str(orig_order)
	for ln in header_lines:
		s = ln.strip()
		if not s or s.startswith("#"):
			continue
		key, sep, val = ln.partition(":")
		if not sep:
			continue
		key = key.strip().lower()
		val = val.strip()
		if key == "title":
			new_title = val
		elif key == "category":
			new_category = val
		elif key == "order":
			new_order_str = val

	changed = {}
	if new_title != orig_title:
		changed["title"] = new_title
	if new_category != orig_category:
		changed["category"] = new_category

	# order: compare as integers; a blank value leaves the order unchanged
	new_order_str = new_order_str.strip()
	if new_order_str != str(orig_order) and new_order_str != "":
		try:
			new_order = int(new_order_str)
			if new_order != orig_order:
				changed["order"] = new_order
		except ValueError:
			print(f"⚠ Ignoring invalid Order value '{new_order_str}' (must be an integer).")

	# content: ignore differences that are only trailing newlines
	if new_content.rstrip("\n") != orig_content.rstrip("\n"):
		changed["content"] = new_content.rstrip("\n")

	return changed


def create_page_interactively(title="", category="", order="", content=""):
	"""Open a new-page buffer in $EDITOR (seeded with any provided fields) and return an
	InputCasePage dict {title, content, category[, order]}.

	Returns None if aborted: empty title/content/category, missing '---' separator, or editor failure.
	"""
	buffer_text = "\n".join([
		"# New TheHive case page. Fill in the fields below, then save and exit.",
		"# Lines in this header starting with '#' are ignored.",
		"# The first line that is exactly '---' separates the header from the",
		"# page content (everything below it is the markdown body).",
		"# Title, Category and content are required; leave them blank to abort.",
		f"Title: {title}",
		f"Category: {category}",
		f"Order: {order}",
		"---",
		content,
	]) + "\n"

	edited = _launch_editor(buffer_text)
	if edited is None:
		return None

	header_lines, new_content = _split_frontmatter(edited)
	if header_lines is None:
		print("✗ Could not find the '---' separator in the edited file; aborting (page not created).")
		return None

	new_title = ""
	new_category = ""
	new_order_str = ""
	for ln in header_lines:
		s = ln.strip()
		if not s or s.startswith("#"):
			continue
		key, sep, val = ln.partition(":")
		if not sep:
			continue
		key = key.strip().lower()
		val = val.strip()
		if key == "title":
			new_title = val
		elif key == "category":
			new_category = val
		elif key == "order":
			new_order_str = val

	new_content = new_content.rstrip("\n")

	missing = [name for name, val in (("Title", new_title), ("Category", new_category), ("content", new_content)) if not val]
	if missing:
		print(f"✗ Missing required field(s): {', '.join(missing)}; aborting (page not created).")
		return None

	page = {"title": new_title, "content": new_content, "category": new_category}
	if new_order_str:
		try:
			page["order"] = int(new_order_str)
		except ValueError:
			print(f"⚠ Ignoring invalid Order value '{new_order_str}' (must be an integer).")
	return page


def edit_case_interactively(case):
	"""Open the case title + description in $EDITOR and return a dict of changed
	fields suitable for InputUpdateCase.

	Returns {} if nothing changed, or None if the edit was aborted / unparseable.
	"""
	orig_title = case.get("title", "")
	orig_description = case.get("description", "")

	buffer_text = "\n".join([
		"# TheHive case editor. Edit the fields below, then save and exit.",
		"# Lines in this header starting with '#' are ignored.",
		"# The first line that is exactly '---' separates the header (Title)",
		"# from the case description (everything below it is the markdown body).",
		"# To abort, save the file unchanged or remove the '---' separator.",
		f"Title: {orig_title}",
		"---",
		orig_description,
	]) + "\n"

	edited = _launch_editor(buffer_text)
	if edited is None:
		return None
	# Unchanged buffer => nothing to do
	if edited == buffer_text:
		return {}

	header_lines, new_description = _split_frontmatter(edited)
	if header_lines is None:
		print("✗ Could not find the '---' separator in the edited file; aborting (no changes applied).")
		return None

	new_title = orig_title
	for ln in header_lines:
		s = ln.strip()
		if not s or s.startswith("#"):
			continue
		key, sep, val = ln.partition(":")
		if not sep:
			continue
		if key.strip().lower() == "title":
			new_title = val.strip()

	changed = {}
	if new_title != orig_title:
		changed["title"] = new_title
	# description: ignore differences that are only trailing newlines
	if new_description.rstrip("\n") != orig_description.rstrip("\n"):
		changed["description"] = new_description.rstrip("\n")

	return changed


