def create_task_interactively(title="", group="", description=""):
	"""Compose a new task in $EDITOR (Title/Group header + description body).
	Returns an InputTask dict, or None if aborted (blank title / no separator / editor failure)."""
	buffer_text = "\n".join([
		"# New TheHive task. Fill in the fields below, then save and exit.",
		"# Lines in this header starting with '#' are ignored.",
		"# The first line that is exactly '---' separates the header from the",
		"# task description (everything below it is the markdown body).",
		"# Title is required; leave it blank to abort.",
		f"Title: {title}",
		f"Group: {group}",
		"---",
		description,
	]) + "\n"

	edited = _launch_editor(buffer_text)
	if edited is None:
		return None
	header_lines, new_description = _split_frontmatter(edited)
	if header_lines is None:
		print("✗ Could not find the '---' separator in the edited file; aborting (task not created).")
		return None

	new_title = ""
	new_group = ""
	for ln in header_lines:
		s = ln.strip()
		if not s or s.startswith("#"):
			continue
		key, sep, val = ln.partition(":")
		if not sep:
			continue
		key = key.strip().lower()
		val = val.strip()
		if key == "title":
			new_title = val
		elif key == "group":
			new_group = val

	if not new_title:
		print("✗ No title provided; aborting (task not created).")
		return None
	task = {"title": new_title}
	if new_group:
		task["group"] = new_group
	desc = new_description.rstrip("\n")
	if desc:
		task["description"] = desc
	return task


